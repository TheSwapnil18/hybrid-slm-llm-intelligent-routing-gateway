# ============================================================
# Hybrid SLM-LLM Intelligent Routing Gateway - Environment Config
# ============================================================

# Cloud LLM API Keys (Obtain from respective provider consoles)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Classifier Mode Configuration
# Options:
#   - "distilbert" : Fine-tuned transformer sequence classifier (Recommended)
#   - "ml"         : TF-IDF + Calibrated Logistic Regression classifier
#   - "heuristic"  : Rule-based regex and keyword scoring
CLASSIFIER_MODE=distilbert
